# Copy this into Streamlit Cloud → App settings → Secrets (do NOT commit real secrets to GitHub)

# --- TiDB Cloud Serverless (recommended — no auto power-off) ---
[mysql]
host = "gateway01.<region>.prod.aws.tidbcloud.com"
port = 4000
user = "<cluster-prefix>.root"      # e.g. "3pTAoNNegb47Uc8.root" — TiDB shows this exact string on the Connect page
password = "your-tidb-password"
database = "smartmart"

# --- Aiven MySQL (old, powers off when idle) ---
# [mysql]
# host = "your-service-name.aivencloud.com"
# port = 12345
# user = "avnadmin"
# password = "your-aiven-password"
# database = "defaultdb"
